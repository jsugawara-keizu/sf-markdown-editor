<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyHtmlTag="false"
  docType="html-5.0"
  contentType="text/html"
>
  <html lang="ja">
    <head>
      <meta charset="UTF-8" />
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        html,
        body {
          width: 100%;
          height: 100%;
          background: #fff;
        }
      </style>
    </head>
    <body>
      <script src="{!URLFOR($Resource.mermaidJs)}"></script>
      <script>
        (function () {
          var initialized = false;

          function ensureInitialized() {
            if (initialized) return;
            // Mirrors markdownViewer's own mermaid.initialize() options so
            // diagrams look identical regardless of which path rendered them.
            mermaid.initialize({
              startOnLoad: false,
              securityLevel: "strict",
              htmlLabels: false,
              flowchart: { htmlLabels: false }
            });
            initialized = true;
          }

          function sendMessage(data) {
            window.parent.postMessage(data, "*");
          }

          window.addEventListener("message", function (event) {
            var data = event.data;
            if (!data || data.type !== "RENDER_MERMAID" || !data.id) return;
            var id = data.id;
            try {
              ensureInitialized();
              mermaid
                .render(id, data.definition)
                .then(function (result) {
                  sendMessage({ type: "MERMAID_RESULT", id: id, svg: result.svg });
                })
                .catch(function (err) {
                  sendMessage({
                    type: "MERMAID_ERROR",
                    id: id,
                    message: String((err && err.message) || err)
                  });
                });
            } catch (err) {
              sendMessage({
                type: "MERMAID_ERROR",
                id: id,
                message: String((err && err.message) || err)
              });
            }
          });

          window.addEventListener("load", function () {
            sendMessage({ type: "PAGE_READY" });
          });
        })();
      </script>
    </body>
  </html>
</apex:page>
