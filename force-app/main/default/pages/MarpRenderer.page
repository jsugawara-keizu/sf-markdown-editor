<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyHtmlTag="false"
  docType="html-5.0"
  contentType="text/html"
>
  <html lang="ja">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        html,
        body {
          width: 100%;
          height: 100%;
          overflow: hidden;
          background: #1a1a2e;
        }
        #slide-container {
          width: 100%;
          height: 100%;
        }
        section {
          display: none !important;
          width: 100% !important;
          height: 100% !important;
          position: absolute !important;
          top: 0;
          left: 0;
          overflow: hidden;
        }
        section.active {
          display: flex !important;
        }
        #status {
          color: #fff;
          font-family: sans-serif;
          font-size: 14px;
          padding: 20px;
        }
      </style>
    </head>
    <body>
      <div id="slide-container">
        <div id="status">Loading Marp...</div>
      </div>
      <div
        id="debug"
        style="
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          background: rgba(0, 0, 0, 0.85);
          color: #0f0;
          font: 11px monospace;
          padding: 4px 8px;
          z-index: 9999;
          white-space: pre-wrap;
          max-height: 120px;
          overflow-y: auto;
        "
      ></div>

      <script src="{!URLFOR($Resource.marpCore)}"></script>
      <script>
        (function () {
          var debugEl = document.getElementById("debug");
          function dbg(msg) {
            debugEl.textContent += msg + "\n";
          }
          dbg("[1] inline script start");
          dbg("[marpCore] typeof MarpCore=" + typeof MarpCore);
          var ALLOWED_ORIGIN = "{!$CurrentPage.URL}".replace(/\/apex\/.*/, "");
          var slideCount = 0;
          var currentSlide = 0;
          var container = document.getElementById("slide-container");

          function showSlide(index) {
            var sections = container.querySelectorAll("section");
            sections.forEach(function (s, i) {
              s.classList.toggle("active", i === index);
            });
            currentSlide = index;
            sendMessage({
              type: "SLIDE_CHANGED",
              slide: currentSlide,
              slideCount: slideCount
            });
          }

          function renderMarkdown(markdown) {
            dbg("[render] called, md length=" + (markdown || "").length);
            try {
              dbg("[render] MarpCore=" + typeof MarpCore + " .Marp=" + (typeof MarpCore !== "undefined" ? typeof MarpCore.Marp : "n/a"));
              var marp = new MarpCore.Marp({ html: false });
              var result = marp.render(markdown);
              var html = result.html;
              var css = result.css;

              // inject CSS
              var existing = document.getElementById("marp-style");
              if (existing) existing.remove();
              var style = document.createElement("style");
              style.id = "marp-style";
              style.textContent =
                css +
                "\nsection{display:none!important;width:100%!important;height:100%!important;position:absolute!important;top:0;left:0;overflow:hidden}" +
                "\nsection.active{display:flex!important}";
              document.head.appendChild(style);

              container.innerHTML = html;
              slideCount = container.querySelectorAll("section").length;
              currentSlide = 0;
              showSlide(0);
              sendMessage({ type: "READY", slideCount: slideCount });
              dbg("[render] ok slides=" + slideCount);
            } catch (e) {
              dbg("[render] ERROR: " + e);
              sendMessage({ type: "ERROR", message: String(e) });
            }
          }

          function sendMessage(data) {
            window.parent.postMessage(data, "*");
          }

          window.addEventListener("message", function (event) {
            var data = event.data;
            if (!data || !data.type) return;
            if (data.type === "RENDER") {
              renderMarkdown(data.markdown);
            } else if (data.type === "GOTO") {
              var idx = Math.max(0, Math.min(data.slide, slideCount - 1));
              showSlide(idx);
            } else if (data.type === "PREV") {
              if (currentSlide > 0) showSlide(currentSlide - 1);
            } else if (data.type === "NEXT") {
              if (currentSlide < slideCount - 1) showSlide(currentSlide + 1);
            } else if (data.type === "PING") {
              sendMessage({ type: "PONG" });
            }
          });

          window.addEventListener("load", function () {
            dbg("[load] window.name=" + window.name.substring(0, 80));
            sendMessage({ type: "PAGE_READY" });
            try {
              var nameData = JSON.parse(window.name || "{}");
              dbg("[load] nameData.markdown length=" + (nameData.markdown || "").length);
              if (nameData.markdown) {
                renderMarkdown(nameData.markdown);
              } else {
                dbg("[load] no markdown in window.name, waiting for postMessage");
              }
            } catch (ignore) {
              dbg("[load] window.name parse error: " + ignore);
          });
        })();
      </script>
    </body>
  </html>
</apex:page>
