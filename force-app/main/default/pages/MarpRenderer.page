<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyHtmlTag="false"
  docType="html-5.0"
  contentType="text/html"
>
  <html lang="ja">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        html,
        body {
          width: 100%;
          height: 100%;
          overflow: hidden;
          background: #1a1a2e;
        }
        #slide-container {
          width: 100%;
          height: 100%;
          position: relative;
        }
        /* section visibility is controlled solely by marp-style (injected at render time) */
        /* section scroll/table overrides are injected after result.css in renderMarkdown()
           so they take precedence over Marp's generated styles. */
        .mermaid svg {
          max-width: 100%;
          height: auto;
        }
      </style>
    </head>
    <body>
      <div id="slide-container"></div>

      <script src="{!URLFOR($Resource.marpCore)}"></script>
      <script src="{!URLFOR($Resource.mermaidJs)}"></script>
      <script>
        (function () {
          var slideCount = 0;
          var currentSlide = 0;
          var container = document.getElementById("slide-container");
          var renderGeneration = 0;
          // Defense in depth alongside marpViewer.js's own in-flight guard:
          // if a RENDER for markdown identical to what's already rendering
          // arrives again (e.g. a duplicate/delayed postMessage), ignore it
          // instead of restarting marp.render() + mermaid from scratch.
          var isRendering = false;
          var lastRequestedMarkdown = null;

          function showSlide(index) {
            // Marp wraps each slide in its own <svg data-marpit-svg>.
            // Operate on svg elements, not sections (sections are inside foreignObject).
            var svgs = container.querySelectorAll("svg[data-marpit-svg]");
            svgs.forEach(function (svg, i) {
              svg.style.setProperty(
                "display",
                i === index ? "block" : "none",
                "important"
              );
            });
            currentSlide = index;
            sendMessage({
              type: "SLIDE_CHANGED",
              slide: currentSlide,
              slideCount: slideCount
            });
          }

          function renderMarkdown(markdown) {
            var myGeneration = ++renderGeneration;
            try {
              var marp = new MarpCore.Marp({ html: false });
              var result = marp.render(markdown);

              var existing = document.getElementById("marp-style");
              if (existing) existing.remove();
              var style = document.createElement("style");
              style.id = "marp-style";
              // Stack SVGs absolutely so only the visible one shows.
              style.textContent =
                result.css +
                "\n#slide-container svg[data-marpit-svg]{position:absolute;top:0;left:0;width:100%;height:100%;display:none}" +
                "\nsection{overflow-y:auto!important;overflow-x:hidden!important;justify-content:flex-start!important}" +
                "\nsection table{display:table!important;height:auto!important;width:100%!important}" +
                "\nsection thead,section tbody,section tfoot{display:table-row-group!important}" +
                "\nsection tr{display:table-row!important;height:auto!important}" +
                "\nsection td,section th{display:table-cell!important;height:auto!important}";
              document.head.appendChild(style);

              container.innerHTML = result.html;

              // Open all links in a new tab.
              container.querySelectorAll("a[href]").forEach(function (a) {
                a.setAttribute("target", "_blank");
                a.setAttribute("rel", "noopener noreferrer");
              });

              // Convert mermaid code blocks to divs.
              container
                .querySelectorAll("code.language-mermaid")
                .forEach(function (code) {
                  var pre = code.parentNode;
                  var div = document.createElement("div");
                  div.className = "mermaid";
                  div.textContent = code.textContent;
                  pre.parentNode.replaceChild(div, pre);
                });

              // Render mermaid diagrams explicitly before hiding slides.
              // mermaid.render() needs elements to be visible to measure size.
              var afterMermaid = function () {
                // A newer renderMarkdown() call has already replaced
                // #slide-container; this generation's work is moot.
                if (myGeneration !== renderGeneration) return;
                isRendering = false;
                slideCount = container.querySelectorAll(
                  "svg[data-marpit-svg]"
                ).length;
                currentSlide = 0;
                showSlide(0);
                sendMessage({ type: "READY", slideCount: slideCount });
              };
              var mermaidDivs = Array.from(
                container.querySelectorAll(".mermaid")
              );
              if (typeof mermaid !== "undefined" && mermaidDivs.length > 0) {
                mermaid.initialize({ startOnLoad: false, theme: "default" });
                // Compile diagrams one at a time and yield to the event loop
                // between each. mermaid.render() does synchronous DOM work
                // that's far more expensive under Lightning Web Security's
                // Proxy membrane; running every diagram back-to-back via
                // Promise.all blocks the frame until all of them finish,
                // which is what reads as the browser freezing when a deck
                // has more than a couple of diagrams. Ids are scoped to this
                // generation so two overlapping renders (e.g. the initial
                // PAGE_READY/iframe-load race) never fight over the same id.
                var renderNext = function (i) {
                  if (myGeneration !== renderGeneration) return;
                  if (i >= mermaidDivs.length) {
                    afterMermaid();
                    return;
                  }
                  var div = mermaidDivs[i];
                  var source = div.textContent;
                  mermaid
                    .render("mermaid-diag-" + myGeneration + "-" + i, source)
                    .then(function (result) {
                      if (myGeneration !== renderGeneration) return;
                      div.innerHTML = result.svg;
                    })
                    .catch(function () {
                      // Leave the source text visible; move on to the rest.
                    })
                    .then(function () {
                      setTimeout(function () {
                        renderNext(i + 1);
                      }, 0);
                    });
                };
                renderNext(0);
              } else {
                afterMermaid();
              }
            } catch (e) {
              isRendering = false;
              sendMessage({ type: "ERROR", message: String(e) });
            }
          }

          function sendMessage(data) {
            window.parent.postMessage(data, "*");
          }

          window.addEventListener("message", function (event) {
            var data = event.data;
            if (!data || !data.type) return;
            if (data.type === "RENDER") {
              if (isRendering && data.markdown === lastRequestedMarkdown) {
                return;
              }
              isRendering = true;
              lastRequestedMarkdown = data.markdown;
              renderMarkdown(data.markdown);
            } else if (data.type === "GOTO") {
              var idx = Math.max(0, Math.min(data.slide, slideCount - 1));
              showSlide(idx);
            } else if (data.type === "PREV") {
              if (currentSlide > 0) showSlide(currentSlide - 1);
            } else if (data.type === "NEXT") {
              if (currentSlide < slideCount - 1) showSlide(currentSlide + 1);
            } else if (data.type === "PING") {
              sendMessage({ type: "PONG" });
            }
          });

          window.addEventListener("load", function () {
            sendMessage({ type: "PAGE_READY" });
          });
        })();
      </script>
    </body>
  </html>
</apex:page>
