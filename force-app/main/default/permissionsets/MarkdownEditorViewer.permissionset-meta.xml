<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Markdown Editor Viewer User</label>
    <description
  >Grants access to MarkdownEditor and MarkdownViewer components, including Apex access and Lightning Experience usage.</description>
    <customPermissions>
        <enabled>true</enabled>
        <name>MarkdownEditorViewerAccess</name>
    </customPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>LightningExperienceUser</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
    <classAccesses>
        <apexClass>MarkdownImageHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
