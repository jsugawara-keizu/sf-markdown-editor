        required="true"
      />
            <property
        name="fieldApiName"
        type="String"
        label="項目 API 名"
        description="Markdown を格納している Long Text Area 項目の API 名（例: Markdown__c）"
        default="Markdown__c"
        required="true"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
